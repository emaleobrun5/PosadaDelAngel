# Base de datos PostgreSQL
DATABASE_URL="postgresql://posada:posada_local_pw@localhost:5432/posada_del_angel?schema=public"

# Contraseña única para entrar al panel interno (/admin). Mínimo 8 caracteres.
ADMIN_PASSWORD="cambiar_esta_password"

# Clave para firmar la cookie de sesión del panel.
# Generar una nueva con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="cambiar_este_secreto"
